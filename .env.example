# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_id
VITE_FIREBASE_APP_ID=your_app_id

# App Configuration
VITE_ENV=production
VITE_MAIN_APP_URL=https://your-app.web.app
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key
VITE_UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# Gmail Automation
VITE_GMAIL_APPS_SCRIPT_URL=your_google_apps_script_url
VITE_GMAIL_APPS_SCRIPT_SECRET=your_google_apps_script_secret
